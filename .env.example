# AgentOS Environment Variables

# Google Gemini API Key (Required for LangChain Gemini reasoning)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Amadeus Flight API Credentials (Self-Service Test / Live)
# Register for free at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_ENV=test

# Alternative: Duffel Air API Key
# Register at: https://duffel.com/
# DUFFEL_API_KEY=your_duffel_api_key_here
